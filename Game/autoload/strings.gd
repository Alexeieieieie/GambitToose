var lang = "en"


func _ready() -> void:
	lang = SaveData.language
	_update_window_title()


func t(a):
	var b = EN if lang == "en" else RU
	if b.has(a):
		return b[a]
	if EN.has(a):
		return EN[a]
	return "!" + str(a) + "!"


func tf(a, b):
	return t(a) % b


func set_lang(a) -> void:
	lang = a if a in ["en", "ru"] else "en"
	SaveData.set_language(lang)
	_update_window_title()


func _update_window_title() -> void:
	OS.set_window_title(t("TITLE"))
