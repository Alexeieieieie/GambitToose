; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

[application]

config/name="GridFlow"
run/main_scene="res://ui/boot.tscn"
config/icon="res://icon.png"

[autoload]

SaveData="*res://autoload/save_data.gd"
Strings="*res://autoload/strings.gd"
Palette="*res://autoload/palette.gd"
Fonts="*res://autoload/fonts.gd"
Levels="*res://autoload/levels.gd"
Sfx="*res://autoload/sfx.gd"
UiRegistry="*res://autoload/ui_registry.gd"

[display]

window/size/width=1280
window/size/height=720
window/stretch/mode="2d"
window/stretch/aspect="keep"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[physics]

common/enable_pause_aware_picking=true

[rendering]

quality/driver/driver_name="GLES2"
environment/default_clear_color=Color( 0.121569, 0.137255, 0.25098, 1 )
environment/default_environment="res://default_env.tres"
